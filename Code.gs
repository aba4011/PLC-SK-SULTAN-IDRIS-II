// SPREADSHEET & DRIVE CONFIGURATIONconst SPREADSHEET_ID = "1HdgiIIYL--Ex7I7Hu_nhPadOHfYr4YG15lo7_knfSw4";const DRIVE_FOLDER_ID = "1aDoQrGklEhmFUdCfj1sz09vCdFZVM0Ni";function doGet(e) {  const action = e.parameter.action;    if (action === "getTeachers") {    return handleGetTeachers();  }    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: "Aksi tidak sah" }))    .setMimeType(ContentService.MimeType.JSON);}function doPost(e) {  try {    const contents = JSON.parse(e.postData.contents);    const action = contents.action;        if (action === "saveOPR") {      return handleSaveOPR(contents.data);    }        return ContentService.createTextOutput(JSON.stringify({ status: "error", message: "Aksi tidak sah" }))      .setMimeType(ContentService.MimeType.JSON);  } catch (err) {    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))      .setMimeType(ContentService.MimeType.JSON);  }}// 1. Ambil Senarai Guru dari Google Sheet (Lajur A)function handleGetTeachers() {  try {    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);    const sheet = ss.getSheets()[0]; // Ambil sheet pertama    const lastRow = sheet.getLastRow();        let teachers = [];    if (lastRow > 1) {      // Mengambil data dari Baris 2 hingga akhir di Lajur A (Senarai Nama Guru)      const values = sheet.getRange(2, 1, lastRow - 1, 1).getValues();      teachers = values.map(row => row[0]).filter(name => name && name.toString().trim() !== "");    }        return ContentService.createTextOutput(JSON.stringify({ status: "success", data: teachers }))      .setMimeType(ContentService.MimeType.JSON);  } catch (err) {    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))      .setMimeType(ContentService.MimeType.JSON);  }}// 2. Simpan Rekod OPR ke Google Sheet & PDF ke Google Drivefunction handleSaveOPR(data) {  try {    // A. Simpan Rekod ke Google Sheet    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);    let logSheet = ss.getSheetByName("REKOD_OPR");        // Cipta sheet REKOD_OPR jika belum wujud    if (!logSheet) {      logSheet = ss.insertSheet("REKOD_OPR");      logSheet.appendRow([        "Masa Simpan", "Strategi PLC", "Tajuk / Fokus", "Tarikh", "Masa",         "Tempat", "Nama Kumpulan", "Ketua Kumpulan", "Disediakan Oleh", "Ahli-ahli", "Pautan PDF Drive"      ]);      logSheet.getRange(1, 1, 1, 11).setFontWeight("bold").setBackground("#e2e8f0");    }        const timestamp = new Date();    const timeRange = `${data.startTime} - ${data.endTime}`;    const membersList = Array.isArray(data.members) ? data.members.join(", ") : data.members;        // B. Cipta Dokumen & PDF    const folder = DriveApp.getFolderById(DRIVE_FOLDER_ID);    const docName = `OPR PLC - ${data.plcFocus} (${data.plcDate})`;    const doc = DocumentApp.create(docName);    const body = doc.getBody();        // Format Susunan Isi PDF    body.appendParagraph("ONE PAGE REPORT (OPR) PROGRAM PLC").setHeading(DocumentApp.ParagraphHeading.HEADING1).setAlignment(DocumentApp.HorizontalAlignment.CENTER);    body.appendParagraph(`KUMPULAN / PANITIA: ${data.groupName}`).setHeading(DocumentApp.ParagraphHeading.HEADING2).setAlignment(DocumentApp.HorizontalAlignment.CENTER);    body.appendParagraph("");        // Jadual Maklumat Utama    const tableData = [      ["Strategi PLC", data.plcStrategy],      ["Tajuk / Fokus", data.plcFocus],      ["Tarikh & Masa", `${data.plcDate} (${timeRange})`],      ["Tempat", data.plcLocation],      ["Ketua Kumpulan", data.groupLeader],      ["Disediakan Oleh", data.preparedBy],      ["Ahli Kumpulan", membersList]    ];        const table = body.appendTable(tableData);    table.setBorderColor("#cbd5e1");        body.appendParagraph("");    body.appendParagraph("RINGKASAN LAPORAN PLC").setHeading(DocumentApp.ParagraphHeading.HEADING2);    body.appendParagraph(`1. ISU / MASALAH:\n${data.plcIssue}\n`);    body.appendParagraph(`2. OBJEKTIF:\n${data.plcObjective}\n`);    body.appendParagraph(`3. PELAKSANAAN:\n${data.plcImplementation}\n`);    body.appendParagraph(`4. IMPAK / HASIL:\n${data.plcImpact}\n`);    body.appendParagraph(`5. TINDAKAN SUSULAN:\n${data.plcFollowup}\n`);        doc.saveAndClose();        // Tukar ke PDF & Alih ke Folder Google Drive    const docFile = DriveApp.getFileById(doc.getId());    const pdfBlob = docFile.getAs(MimeType.PDF);    const pdfFile = folder.createFile(pdfBlob).setName(`${docName}.pdf`);    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);        // Padam dokumen sementara    docFile.setTrashed(true);        const pdfUrl = pdfFile.getUrl();        // Masukkan baris rekod ke Sheet REKOD_OPR    logSheet.appendRow([      timestamp, data.plcStrategy, data.plcFocus, data.plcDate, timeRange,      data.plcLocation, data.groupName, data.groupLeader, data.preparedBy, membersList, pdfUrl    ]);        return ContentService.createTextOutput(JSON.stringify({       status: "success",       message: "OPR Berjaya Disimpan!",      pdfUrl: pdfUrl     })).setMimeType(ContentService.MimeType.JSON);      } catch (err) {    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))      .setMimeType(ContentService.MimeType.JSON);  }}